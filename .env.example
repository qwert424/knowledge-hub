# ============================================================
# 只放三类东西：接入点、凭证、端口
# 模型名 / 切分 / 检索权重 / JEV 阈值 一律放 Nacos（见 deploy/nacos/knowledge-hub.yaml）
# ============================================================
APP_ENV=local
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# ---------- 本项目自有中间件（新增容器） ----------
KH_PG_HOST=127.0.0.1
KH_PG_PORT=5433
KH_PG_DB=kh
KH_PG_USER=kh_app
KH_PG_PASSWORD=kh_app_local
KH_REDIS_HOST=127.0.0.1
KH_REDIS_PORT=6380
KH_REDIS_PASSWORD=

# ---------- 复用已有 RAG 栈（与 ai-infrastructure-rag-practice/.env 保持一致） ----------
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB_NAME=knowledge_hub
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=knowledge-hub
NACOS_SERVER=http://127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=knowledge-hub.yaml
NACOS_USERNAME=
NACOS_PASSWORD=
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 服务地址（本地开发） ----------
SERVER_PORT=8088
BACKEND_BASE_URL=http://127.0.0.1:8088
RAG_ENGINE_BASE_URL=http://127.0.0.1:8100
AGENT_BASE_URL=http://127.0.0.1:8123
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8088

# ---------- 安全 ----------
SECRET_MASTER_KEY=
INTERNAL_SERVICE_TOKEN=internal-local-token
RETRIEVAL_TICKET_TTL_SECONDS=300

# ---------- 飞书（可选，首期不联调可留空） ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=