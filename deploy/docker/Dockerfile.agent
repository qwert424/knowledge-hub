# syntax=docker/dockerfile:1
#
# Python RAG engine + index worker (FastAPI / arq, managed by uv).
# Build context = repository root:
#   docker build -f deploy/docker/Dockerfile.agent -t knowledge-hub/agent .
#
# The same image runs both services:
#   engine : uvicorn knowledge_hub.api.main:app --port 8100   (default CMD)
#   worker : arq knowledge_hub.worker.settings.WorkerSettings  (compose `command`)

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS base

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates tzdata libmagic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Whole source tree first: agent/ is generated by the Agent track, so a two-step
# pom/pyproject cache split would be fragile. uv's own cache mount keeps rebuilds cheap.
COPY agent/ /app/

# `--frozen` (lockfile honouring) when agent/uv.lock exists, plain sync otherwise.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev || uv sync --no-dev

ENV PATH="/app/.venv/bin:${PATH}" \
    APP_ENV=docker \
    JWT_PUBLIC_KEY_PATH=/app/secrets/jwt-public.pem

RUN groupadd --gid 10001 kh \
    && useradd --uid 10001 --gid kh --create-home --shell /usr/sbin/nologin kh \
    && mkdir -p /app/secrets \
    && chown -R 10001:10001 /app

USER 10001:10001

EXPOSE 8100

HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=12 \
    CMD curl -fsS http://127.0.0.1:8100/health || exit 1

CMD ["uvicorn", "knowledge_hub.api.main:app", "--host", "0.0.0.0", "--port", "8100", "--proxy-headers"]
