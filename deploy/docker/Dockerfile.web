# syntax=docker/dockerfile:1
#
# Next.js apps (portal | admin) built from the pnpm workspace in web/.
# Build context = repository root:
#   docker build -f deploy/docker/Dockerfile.web --build-arg APP=portal -t knowledge-hub/web-portal .
#   docker build -f deploy/docker/Dockerfile.web --build-arg APP=admin  -t knowledge-hub/web-admin .
#
# Runs `next start` on port 3000 inside the container (compose publishes 3100/3101).
# The apps' own `dev`/`start` scripts hardcode 3100/3101, so the port is passed
# explicitly instead of going through `pnpm start`.
#
# TODO(web track): adding `output: "standalone"` to apps/*/next.config.* lets this
# image shrink to a small runner - see deploy/README.md "known gaps".

# ---------------------------------------------------------------- build stage
FROM node:22-alpine AS build

ARG APP=portal
ARG NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8088

ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_TELEMETRY_DISABLED=1 \
    CI=1

RUN apk add --no-cache libc6-compat tzdata \
    && npm install -g pnpm@11

WORKDIR /app
COPY web/ /app/

RUN pnpm install --frozen-lockfile || pnpm install

RUN pnpm --filter "./apps/${APP}" build

# -------------------------------------------------------------- runtime stage
FROM node:22-alpine AS runtime

ARG APP=portal

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    APP=${APP} \
    TZ=Asia/Shanghai

RUN apk add --no-cache curl tzdata \
    && npm install -g pnpm@11 \
    && addgroup -g 10001 -S nextjs \
    && adduser -u 10001 -S nextjs -G nextjs

WORKDIR /app
# node_modules + build output live in the same absolute path in both stages, so the
# pnpm symlink farm stays valid.
COPY --from=build --chown=10001:10001 /app/ /app/

USER 10001:10001

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=12 \
    CMD curl -fsS "http://127.0.0.1:3000/" > /dev/null || exit 1

# 直接调 next 二进制：pnpm 的 shim 会按 packageManager 字段去联网下载自己，
# 容器内没有外网时会启动失败（ERR_PNPM_FETCH / fetch failed）。
CMD ["sh", "-c", "cd /app/apps/$APP && exec ./node_modules/.bin/next start -p \"$PORT\" -H \"$HOSTNAME\""]
